# GEMINI_API_KEY: Required for Gemini AI API calls (Vision diagnosis fallback and visual grounding).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# META_MODEL_API_KEY: Optional/Hackathon key for official Meta Model API (https://api.meta.ai/v1)
# Used when provider is set to "meta". Drop-in OpenAI SDK compatible.
META_MODEL_API_KEY="MY_META_MODEL_API_KEY"
META_MODEL_NAME="muse-spark-1.3"

# GOOGLE_MAPS_API_KEY: Optional for Google Places & Maps API
GOOGLE_MAPS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
